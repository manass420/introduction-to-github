#include <SFML/Graphics.hpp>
#include <SFML/Window.hpp>
#include <iostream>

using namespace std;

int main() {
    sf::RenderWindow window(sf::VideoMode(600, 400), "Be My Valentine?", sf::Style::Close);
    window.clear(sf::Color(255, 0, 0)); // Red background

    sf::Font font;
    if (!font.loadFromFile("arial.ttf")) {
        cout << "Error loading font!" << endl;
        return -1;
    }

    sf::Text text("Will you be my Valentine?", font, 30);
    text.setFillColor(sf::Color::White);
    text.setPosition(150, 100);

    sf::RectangleShape yesButton(sf::Vector2f(100, 50));
    yesButton.setFillColor(sf::Color::White);
    yesButton.setPosition(150, 200);
    sf::Text yesText("Yes", font, 24);
    yesText.setFillColor(sf::Color::Black);
    yesText.setPosition(175, 210);

    sf::RectangleShape noButton(sf::Vector2f(100, 50));
    noButton.setFillColor(sf::Color(128, 128, 128)); // Gray (unclickable look)
    noButton.setPosition(350, 200);
    sf::Text noText("No", font, 24);
    noText.setFillColor(sf::Color(64, 64, 64));
    noText.setPosition(375, 210);

    bool showMessage = false;
    sf::Text message("Yay! Happy Valentine's Day!", font, 28);
    message.setFillColor(sf::Color::White);
    message.setPosition(120, 300);

    while (window.isOpen()) {
        sf::Event event;
        while (window.pollEvent(event)) {
            if (event.type == sf::Event::Closed)
                window.close();

            if (event.type == sf::Event::MouseButtonPressed && event.mouseButton.button == sf::Mouse::Left) {
                sf::Vector2i mousePos = sf::Mouse::getPosition(window);
                if (yesButton.getGlobalBounds().contains(mousePos.x, mousePos.y)) {
                    showMessage = true;
                }
            }
        }

        window.clear(sf::Color(255, 0, 0));
        window.draw(text);
        window.draw(yesButton);
        window.draw(yesText);
        window.draw(noButton);
        window.draw(noText);

        if (showMessage)
            window.draw(message);

        window.display();
    }
    return 0;
}
